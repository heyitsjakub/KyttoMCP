{
	"coworkUserFilesPath": "/Users/example/Claude",
	"mcpServers": {
		"github": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-github"],
			"env": {
				"GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_exampletokenvalue"
			}
		},
		"postgres": {
			"type": "stdio",
			"command": "/opt/homebrew/bin/mcp-postgres",
			"args": []
		},
		"remote-docs": {
			"type": "http",
			"url": "https://docs.example.com/mcp"
		}
	},
	"preferences": {
		"chromeExtensionEnabled": true,
		"quickEntryShortcut": "off"
	}
}
